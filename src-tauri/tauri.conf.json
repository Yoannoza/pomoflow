{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pomoflow",
  "version": "0.1.0",
  "identifier": "com.pomoflow.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "TAURI_ENV_PLATFORM=darwin npm run dev",
    "beforeBuildCommand": "bash scripts/tauri-build.sh"
  },
  "app": {
    "windows": [
      {
        "title": "PomoFlow",
        "width": 1200,
        "height": 800,
        "minWidth": 420,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.notion.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; media-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
